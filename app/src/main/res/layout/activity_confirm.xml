<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmActivity">
    <TextView
        android:id="@+id/tvCode"
        android:text="@string/code"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvConfirmCode"
        app:layout_constraintTop_toTopOf="@id/tvCode"
        app:layout_constraintStart_toEndOf="@id/tvCode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvCode"
        android:layout_width="0dp"
        android:textAppearance="@android:style/TextAppearance.Large"
        android:layout_height="wrap_content"
        tools:text="0.0"/>


    <TextView
        android:id="@+id/tvQuantity"
        android:text="@string/quant"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvCode"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvConfirmQuantity"
        app:layout_constraintTop_toTopOf="@id/tvQuantity"
        app:layout_constraintStart_toEndOf="@id/tvQuantity"
        app:layout_constraintBottom_toBottomOf="@id/tvQuantity"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Large"
        tools:text="0.0"/>

    <TextView
        android:id="@+id/tvValue"
        android:text="@string/valor"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuantity"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvConfirmValue"
        app:layout_constraintTop_toTopOf="@id/tvValue"
        app:layout_constraintStart_toEndOf="@id/tvValue"
        app:layout_constraintBottom_toBottomOf="@id/tvValue"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:textAppearance="@android:style/TextAppearance.Large"
        android:layout_height="wrap_content"
        tools:text="0.0"/>

    <Button
        android:id="@+id/btConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvConfirmValue"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>