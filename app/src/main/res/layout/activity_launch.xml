<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LaunchActivity">

    <TextView
        android:id="@+id/tvCode"
        android:text="@string/code"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etCode"
        app:layout_constraintTop_toTopOf="@id/tvCode"
        app:layout_constraintStart_toEndOf="@id/tvCode"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:inputType="number"
        android:layout_height="wrap_content"/>


    <TextView
        android:id="@+id/tvQuantity"
        android:text="@string/quant"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvCode"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etQuantity"
        app:layout_constraintTop_toTopOf="@id/tvQuantity"
        app:layout_constraintStart_toEndOf="@id/tvQuantity"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:inputType="number"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvValue"
        android:text="@string/valor"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuantity"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etValue"
        app:layout_constraintTop_toTopOf="@id/tvValue"
        app:layout_constraintStart_toEndOf="@id/tvValue"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:inputType="numberDecimal"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btList"
        app:layout_constraintTop_toBottomOf="@id/etValue"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@+id/btList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/list"
        app:layout_constraintTop_toBottomOf="@id/etValue"
        app:layout_constraintStart_toEndOf="@id/btConfirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>